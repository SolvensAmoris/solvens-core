// Una Star es una constante global: se declara con un valor, no recibe
// flujos (E105) y no es objetivo válido de `usa` (E103). Existe para
// nombrar valores fijos del sistema, no como nodo de dependencia.
universe "ConEstrella" {
    metadata {
        version: "1.0"
        author: "Test"
        standard: "Cosmos"
    }

    sun Sol

    star "MaxUsers" @max_users {
        value: 100
    }

    galaxy "G" @g {
        position: (50.0, 0.0)

        planet "A" @a {
            position: (25.0, 0.0)
            mass: 20
            type: Operation
        }
    }
}
