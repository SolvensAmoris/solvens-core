// Mínimo válido: un Sol, una galaxia, un planeta, un flujo.
universe "Basico" {
    metadata {
        version: "1.0"
        author: "Test"
        standard: "Cosmos"
    }

    sun Sol

    galaxy "G" @g {
        position: (50.0, 0.0)

        planet "A" @a {
            position: (25.0, 0.0)
            mass: 20
            type: Operation
        }
    }

    light {
        from: Sol
        to: @a
        flow: Primary
    }
}
