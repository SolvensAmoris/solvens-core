// E101: dos planetas con el mismo @id.
universe "TestE101" {
    metadata {
        version: "1.0"
        author: "Test"
        standard: "Cosmos"
    }

    sun Sol

    galaxy "G" @g {
        position: (50.0, 0.0)

        planet "A" @a {
            position: (25.0, 0.0)
            mass: 20
            type: Operation
        }

        planet "B" @a {
            position: (55.0, 0.0)
            mass: 20
            type: Compute
        }
    }
}
