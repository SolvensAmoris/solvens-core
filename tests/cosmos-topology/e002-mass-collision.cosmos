// E002: dos planetas en la misma posición (distancia 0 < 0.5).
universe "TestE002" {
    metadata {
        version: "1.0"
        author: "Test"
        standard: "Cosmos"
    }

    sun Sol

    galaxy "G" @g {
        position: (50.0, 0.0)

        planet "A" @a {
            position: (25.0, 0.0)
            mass: 20
            type: Operation
        }

        planet "B" @b {
            position: (25.0, 0.0)
            mass: 20
            type: Compute
        }
    }
}
