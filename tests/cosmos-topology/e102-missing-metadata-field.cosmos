universe "TestE102" {
    metadata {
        version: "1.0"
        standard: "Cosmos"
    }

    sun Sol

    galaxy "G" @g {
        position: (50.0, 0.0)

        planet "A" @a {
            position: (25.0, 0.0)
            mass: 20
            type: Operation
        }
    }
}
