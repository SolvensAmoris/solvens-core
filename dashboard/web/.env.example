# Public OIDC client configuration for the dashboard.
# Register this as a public client with Authorization Code + PKCE (S256).
NEXT_PUBLIC_OIDC_AUTHORITY=https://identity.example.com
NEXT_PUBLIC_OIDC_CLIENT_ID=your-public-client-id
NEXT_PUBLIC_OIDC_API_SCOPE=api://solvens-core/access
NEXT_PUBLIC_OIDC_API_URL=https://api.example.com

# Must exactly match the redirect URIs registered with the provider.
NEXT_PUBLIC_OIDC_REDIRECT_URI=https://dashboard.example.com/auth/callback
NEXT_PUBLIC_OIDC_SILENT_REDIRECT_URI=https://dashboard.example.com/auth/silent-callback
NEXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI=https://dashboard.example.com/

# Optional extra scope, e.g. offline_access if the provider issues refresh tokens.
NEXT_PUBLIC_OIDC_EXTRA_SCOPE=
