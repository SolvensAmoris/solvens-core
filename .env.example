# SOLVENS CORE Configuration
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME="SOLVENS CORE"
DEBUG=false
LOG_LEVEL=INFO

# Paths
DATA_DIR=~/.solvens
CACHE_DIR=~/.cache/solvens

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Agent Configuration
MAX_CONCURRENT_AGENTS=10
TASK_TIMEOUT=300
MAX_RETRIES=3

# Memory Configuration
MEMORY_BACKEND=memory
# REDIS_URL=redis://localhost:6379

# Router Configuration
DEFAULT_PROVIDER=openai
FALLBACK_PROVIDER=ollama
COST_OPTIMIZATION=true

# === Provider API Keys ===
# Only configure the providers you want to use

# OpenAI (GPT-4, GPT-3.5)
# OPENAI_API_KEY=sk-...

# Anthropic (Claude 3)
# ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini)
# GOOGLE_API_KEY=...

# DeepSeek
# DEEPSEEK_API_KEY=...

# Grok
# GROK_API_KEY=...

# Sakana
# SAKANA_API_KEY=...

# Pollo AI
# POLLO_AI_API_KEY=...
