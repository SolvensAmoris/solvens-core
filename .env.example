# SOLVENS CORE Configuration
# Copy this file to .env and fill in your values

# ===========================================
# SECURITY (REQUIRED FOR PRODUCTION)
# ===========================================
SOLVENS_SECRET_KEY=your-secret-key-here

# ===========================================
# APPLICATION
# ===========================================
APP_NAME="SOLVENS CORE"
DEBUG=false
LOG_LEVEL=INFO

# ===========================================
# PATHS
# ===========================================
DATA_DIR=~/.solvens
CACHE_DIR=~/.cache/solvens

# ===========================================
# API SERVER
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# ===========================================
# AGENT CONFIGURATION
# ===========================================
MAX_CONCURRENT_AGENTS=10
TASK_TIMEOUT=300
MAX_RETRIES=3

# ===========================================
# MEMORY CONFIGURATION
# ===========================================
MEMORY_BACKEND=memory
# REDIS_URL=redis://localhost:6379

# ===========================================
# ROUTER CONFIGURATION
# ===========================================
DEFAULT_PROVIDER=openai
FALLBACK_PROVIDER=ollama
COST_OPTIMIZATION=true

# ===========================================
# TELEMETRY
# ===========================================
# Set to 0 to disable telemetry
COSMOS_TELEMETRY=1

# ===========================================
# PROVIDER API KEYS
# ===========================================
# Only configure the providers you want to use

# --- OpenAI (GPT-4, GPT-3.5) ---
# OPENAI_API_KEY=sk-...

# --- Anthropic (Claude 3) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Google (Gemini) ---
# GOOGLE_API_KEY=...

# --- DeepSeek ---
# DEEPSEEK_API_KEY=...

# --- Grok (xAI) ---
# GROK_API_KEY=...
# XAI_API_KEY=...

# --- Sakana AI ---
# SAKANA_API_KEY=...

# --- Pollo AI ---
# POLLO_AI_API_KEY=...

# ===========================================
# LOCAL MODELS (Ollama)
# ===========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
